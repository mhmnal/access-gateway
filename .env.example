# Access control configuration
ALLOWED_DOMAIN=example.edu
PORT=3000
HOST=127.0.0.1

# Session lifetime in minutes
SESSION_TTL_MINUTES=480

# Set to 1 when the app sits behind an HTTPS proxy (adds Secure to the cookie)
PROXY_TLS=0

# Path to the SQLite file (relative paths resolve from the project root)
DB_PATH=./data/gateway.db

# Password given to the demo accounts by `npm run seed`
SEED_PASSWORD=demo1234
